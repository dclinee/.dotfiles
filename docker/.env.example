# ============================================================
# Dotfiles Docker 环境变量模板
# ============================================================
# 复制本文件为 .env 后按需修改。所有变量均有默认值，无需全部设置。

# 基础镜像（仅主 Dockerfile 用）
BASE_IMAGE=ubuntu:24.04

# apt 镜像源（USTC），留空或设 NO_MIRROR=1 禁用
APT_MIRROR=https://mirrors.ustc.edu.cn/ubuntu
DEBIAN_MIRROR=https://mirrors.ustc.edu.cn/debian
FEDORA_MIRROR=https://mirrors.ustc.edu.cn/fedora

# 镜像名 + 标签
IMAGE_NAME=dotfiles-dev
IMAGE_TAG=latest

# 容器内用户名/UID
DOTFILES_USER=dotfiles-dev
DOTFILES_UID=1000

# 禁用所有镜像源（构建时传 --build-arg NO_MIRROR=1 或运行时 env）
NO_MIRROR=0
