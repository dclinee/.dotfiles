# ======================
# macOS 专属生态（应用 + 服务）
# ======================
# 通用包请在主 Brewfile 中维护
# 字体已拆分到 Brewfile.fonts，首次安装耗时较长可跳过

# Mac App Store
brew "mas"

# 常用应用
cask "iterm2"
cask "visual-studio-code"
cask "google-chrome"
cask "alfred"

# 服务（按需启动）
brew "postgresql", restart_service: true
brew "redis", restart_service: :changed
