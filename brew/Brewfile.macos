# ======================
# macOS 专属生态
# ======================
# 通用包请在主 Brewfile 中维护，本文件仅包含 macOS 特定的包

# Mac App Store
brew "mas"

# 常用应用
cask "iterm2"
cask "visual-studio-code"
cask "google-chrome"
cask "alfred"

# 字体
cask "font-fira-code-nerd-font"

# 服务（按需启动）
brew "postgresql", restart_service: true
brew "redis", restart_service: :changed
