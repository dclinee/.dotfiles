{
  "_说明": "工地电子栅栏 - 定义工地边界和内部区域",
  "_坐标系统": "WGS84 GPS 坐标 (经度, 纬度)",

  "site_geofence": {
    "name": "智慧工地施工区",
    "center": [116.397428, 39.909204],
    "radius_meters": 500,
    "boundary": [
      [116.396000, 39.911000],
      [116.399000, 39.911000],
      [116.399000, 39.908000],
      [116.396000, 39.908000]
    ]
  },

  "sub_zones": [
    {
      "id": "zone_office",
      "name": "办公区",
      "type": "safe",
      "boundary": [
        [116.396500, 39.910800],
        [116.397000, 39.910800],
        [116.397000, 39.910400],
        [116.396500, 39.910400]
      ]
    },
    {
      "id": "zone_a",
      "name": "A区(钢结构)",
      "type": "work",
      "boundary": [
        [116.397000, 39.910800],
        [116.397800, 39.910800],
        [116.397800, 39.910200],
        [116.397000, 39.910200]
      ]
    },
    {
      "id": "zone_b",
      "name": "B区(土建)",
      "type": "work",
      "boundary": [
        [116.397800, 39.910800],
        [116.398600, 39.910800],
        [116.398600, 39.910200],
        [116.397800, 39.910200]
      ]
    },
    {
      "id": "zone_c",
      "name": "C区(机电)",
      "type": "work",
      "boundary": [
        [116.397000, 39.910200],
        [116.397800, 39.910200],
        [116.397800, 39.909600],
        [116.397000, 39.909600]
      ]
    },
    {
      "id": "zone_danger_tower",
      "name": "塔吊下方危险区",
      "type": "danger",
      "boundary": [
        [116.397200, 39.910000],
        [116.397600, 39.910000],
        [116.397600, 39.909600],
        [116.397200, 39.909600]
      ]
    },
    {
      "id": "zone_danger_pit",
      "name": "基坑边缘危险区",
      "type": "danger",
      "boundary": [
        [116.398000, 39.909400],
        [116.398600, 39.909400],
        [116.398600, 39.909000],
        [116.398000, 39.909000]
      ]
    }
  ],

  "alerts": {
    "geofence_exit": {
      "enabled": true,
      "message": "工人 {name} 已离开工地范围",
      "notify": ["team_leader", "safety_officer"]
    },
    "danger_zone_enter": {
      "enabled": true,
      "message": "工人 {name} 进入危险区域: {zone_name}",
      "notify": ["worker", "team_leader", "safety_officer"]
    },
    "unauthorized_zone": {
      "enabled": true,
      "message": "工人 {name} 进入未授权区域: {zone_name}",
      "notify": ["worker", "team_leader"]
    },
    "long_stay": {
      "enabled": true,
      "minutes": 30,
      "message": "工人 {name} 在 {zone_name} 停留超过 {minutes} 分钟",
      "notify": ["team_leader"]
    }
  }
}