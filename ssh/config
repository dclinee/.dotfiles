# ======================
# SSH 主配置（入口）
# ======================
#
# 使用方法:
#   1. 安装时自动创建符号链接: ln -sf ~/.dotfiles/ssh/config ~/.ssh/config
#   2. 本机私有配置请在 ~/.ssh/config.local 中配置（不会提交到仓库）
#
# 加载顺序（Include 按顺序展开；ssh 对同一选项取"首次出现"的值）:
#   1. config.d/*.conf      通用片段（core → github → hosts）
#   2. platform/*.conf      平台片段（macOS / Linux，跨平台安全）
#   3. ~/.ssh/config.local  本机私有覆盖（不提交到仓库）

Include ~/.dotfiles/ssh/config.d/*.conf
Include ~/.dotfiles/ssh/platform/*.conf
Include ~/.ssh/config.local
