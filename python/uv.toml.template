# uv 全局配置
# 文档: https://docs.astral.sh/uv/concepts/config/

# 国内镜像源（清华 TUNA）
index-url = "https://pypi.tuna.tsinghua.edu.cn/simple/"
extra-index-url = [
  "https://mirrors.aliyun.com/pypi/simple/",
  "https://pypi.mirrors.ustc.edu.cn/simple/",
]

# 缓存目录
cache-dir = "~/.cache/uv"

# 并发下载
concurrent-downloads = 100
