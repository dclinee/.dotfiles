# ======================
# Git 全局配置模板
# ======================
#
# 使用方法:
#   1. 安装时自动创建符号链接: ln -sf ~/.dotfiles/git/.gitconfig ~/.gitconfig
#   2. 个人信息请在 ~/.gitconfig.local 中配置（不会提交到仓库）
#
# 在 ~/.gitconfig.local 中添加:
#   [user]
#       name = Your Name
#       email = your@email.com

# --- 用户信息 ---
# 个人 name/email 不在仓库中硬编码，请在 ~/.gitconfig.local 配置
# bootstrap.sh 安装时会自动创建 .gitconfig.local 模板
[user]
    # 占位符已注释：首次使用请在 ~/.gitconfig.local 中配置 name 和 email
    # 取消注释以下行以使用全局默认值（不推荐，建议使用 .gitconfig.local）
    # name = YOUR_NAME
    # email = YOUR_EMAIL

# --- 核心配置 ---
[core]
    editor = nvim
    pager = less -FRX
    autocrlf = input
    quotepath = false
    excludesfile = ~/.dotfiles/git/.gitignore_global
    attributesfile = ~/.dotfiles/git/.gitattributes
    # Git hooks 目录（可选，集中管理公共 hooks）
    hooksPath = ~/.dotfiles/git/hooks
	compression = 0

# --- 初始化配置 ---
[init]
    defaultBranch = main

# --- 拉取配置 ---
[pull]
    rebase = false

# --- 协议配置 ---
[protocol]
    version = 2

# --- 推送配置 ---
[push]
    default = current
    autoSetupRemote = true

# --- diff 配置 ---
[diff]
    algorithm = histogram
    tool = nvimdiff

[difftool]
    prompt = false

# --- merge 配置 ---
[merge]
    tool = nvimdiff
    conflictstyle = zdiff3

[mergetool]
    prompt = false
    keepBackup = false

# --- 颜色 ---
[color]
    ui = auto
[color "status"]
    added = green bold
    changed = yellow bold
    untracked = red bold
[color "branch"]
    current = cyan bold
    local = green
    remote = yellow

# --- 别名 ---
[alias]
    # 基础操作
    co = checkout
    ci = commit
    st = status -sb
    br = branch -vv
    sw = switch

    # 日志
    lg = log --oneline --graph --decorate -20
    lga = log --oneline --graph --decorate --all -20
    ll = log --pretty=format:'%C(yellow)%h%C(reset) %C(green)(%cr)%C(reset) %C(bold)%s%C(reset) %C(blue)<%an>%C(reset)' --abbrev-commit
    lll = log --pretty=format:'%C(yellow)%h%C(reset) %C(green)(%cr)%C(reset) %C(bold)%s%C(reset) %C(blue)<%an>%C(reset)%C(red)%d%C(reset)' --abbrev-commit --name-status

    # 差异
    d = diff
    dc = diff --cached
    ds = diff --staged
    dt = difftool

    # 暂存
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    amend-new = commit --amend

    # 分支
    bd = branch -d
    bD = branch -D
    bm = branch -m
    ba = branch -a

    # 远程
    ra = remote add
    rr = remote rm
    rv = remote -v
    ru = remote update

    # 标签
    t = tag
    td = tag -d

    # 储藏
    sh = stash
    shp = stash pop
    shl = stash list
    shd = stash drop

    # 清理
    clean-dry = clean -nd
    clean-go = clean -fd

    # 实用
    last = log -1 HEAD
    uncommit = reset --soft HEAD~1
    contribute = shortlog -sne --all
    whoami = config user.name && config user.email
    aliases = config --get-regexp ^alias\\.
    edit = !git diff --name-only --diff-filter=U | xargs ${EDITOR:-vim}

    # --- GitHub 相关（需安装 GitHub CLI: gh） ---
    ghpr = "!gh pr view --web"
    ghprlist = "!gh pr list"
    ghissue = "!gh issue view --web"
    ghissuelist = "!gh issue list"
    ghrepo = "!gh repo view --web"
    ghprcreate = "!gh pr create"
    ghrelease = "!gh release list"
    ghworkflow = "!gh workflow list"
    ghruncancel = "!gh run cancel"
    ghrerun = "!gh run rerun"
    ghstatus = "!gh repo view --json name,description,stargazerCount,forkCount,updatedAt"
    ghauth = "!gh auth status"
    ghlabels = "!gh label list"
    ghmilestones = "!gh milestone list"

# --- 凭证 ---
# 默认使用内存缓存（避免明文存储 Token/密码）
# macOS 可改用: helper = osxkeychain
# Linux 可改用: helper = /usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret
# 保守方案：内存缓存 1 小时
[credential]
	helper = store
    # 缓存有效期（秒）
    timeout = 3600
    # 以下为备选方案，按需切换:
    # helper = store     # 明文存储（仅适合个人单用户机器）
    # helper = cache --timeout=7200  # 延长缓存至 2 小时

# --- GPG 签名 ---
# 启用 Git 提交/标签签名
# 具体密钥在 ~/.gitconfig.local 中配置:
#   gpg.program = gpg
#   gpg.format = openpgp
#   user.signingkey = YOUR_KEY_ID
[gpg]
    # macOS 可能需要: program = /usr/local/bin/gpg
    # Linux 可能需要: program = /usr/bin/gpg
    program = gpg

[commit]
    # 默认启用签名（需要在 ~/.gitconfig.local 中设置 user.signingkey）
    # gpgsign = true

[tag]
    # 默认启用标签签名
    # gpgsign = true

# --- rerere ---
[rerere]
    enabled = true

# --- 子模块 ---
[submodule]
    recurse = true

# --- include local 覆盖 ---
[include]
    path = ~/.gitconfig.local
# --- 安全目录 ---
# 留空为安全默认值，仅允许用户显式授权的仓库
# 如需信任某个目录，使用: git config --global safe.directory /path/to/repo
# 或在 ~/.gitconfig.local 中添加:
# [safe]
#     directory = /path/to/trusted/repo
[http]
	postBuffer = 524288000
	timeout = 300
[safe]
	directory = *
