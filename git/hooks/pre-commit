#!/usr/bin/env bash
# pre-commit: 检查尾随空格和行尾
set -euo pipefail

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)
fi

files=$(git diff --cached --name-only --diff-filter=AM "$against")
if [[ -z "$files" ]]; then
  exit 0
fi

# 检查尾随空格
trailing_files=$(echo "$files" | xargs grep -l '[[:space:]]$' 2>/dev/null || true)
if [[ -n "$trailing_files" ]]; then
  echo "❌ 以下文件包含尾随空格:"
  echo "$trailing_files"
  echo "请运行: sed -i 's/[[:space:]]*$//' <file>"
  exit 1
fi

# 检查行尾（Windows 行尾转义）
crlf_files=$(echo "$files" | xargs grep -l $'\r' 2>/dev/null || true)
if [[ -n "$crlf_files" ]]; then
  echo "❌ 以下文件包含 CRLF 行尾:"
  echo "$crlf_files"
  echo "请运行: dos2unix <file> 或修改 .gitattributes"
  exit 1
fi

echo "✅ pre-commit 检查通过"
exit 0
